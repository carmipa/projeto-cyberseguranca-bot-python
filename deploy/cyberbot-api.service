[Unit]
Description=CyberBot GRC - FastAPI Backend Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/projeto-cyberseguranca-bot-python
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/projeto-cyberseguranca-bot-python/.venv/bin/python3 -m uvicorn vps_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cyberbot-api

[Install]
WantedBy=multi-user.target
